# 复制为 .env 后按需修改（不要提交到公开仓库）
# 飞牛 NAS 上对外访问端口（容器内固定 3000）
APP_PORT=5230

# ---------- 登录账号（必改） ----------
# 打开系统 / 手机 APP 都必须先输入这里的账号密码
AUTH_USER=admin
AUTH_PASS=qiaoliang@2026
# 登录有效期（小时），默认 720 小时（30 天）
AUTH_TTL_HOURS=720
# 令牌签名密钥，可留空（留空时由账号密码派生）。建议填一段随机字符串，
# 例如：AUTH_SECRET=8f3c9a2e7b1d4056a9c8e2f7b3d6041c
AUTH_SECRET=

# ---------- 可选：AI 图片识别（OpenAI 兼容视觉模型） ----------
# 留空则关闭 AI 识别，普通照片上传不受影响
VISION_PROVIDER=disabled
VISION_API_KEY=
# OpenAI: https://api.openai.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM: https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama: http://127.0.0.1:11434/v1
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_MS=60000
